## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates
*.env
*.userprefs

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Oo]bj/
[Oo]ut/
[Ll]og/
[Ll]ogs/
**/[Bb]in/*

# Visual Studio cache and generated files
.vs/
Generated\ Files/
*.ilk
*.meta
*.obj
*.pdb
*.pch
*.cache
*.tmp
*.log
*.tlog
*.vspscc
*.vssscc
.builds
*.pidb
*.svclog
*.scc

# Test results and coverage
[Tt]est[Rr]esult*/
*.trx
*.coverage
*.coveragexml

# .NET and NuGet artifacts
project.lock.json
project.fragment.lock.json
artifacts/
.artifacts/
*.nupkg
*.snupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/

# Publish output and settings
publish/
*.pubxml
*.publishproj
PublishScripts/

# Common Visual Studio tooling caches
_ReSharper*/
*.DotSettings.user
_NCrunch_*
.NCrunch_*
.axoCover/*
!.axoCover/settings.json
BenchmarkDotNet.Artifacts/

